# Orchestrator agent — environment template
#
# LOCAL DEV (`agentcore dev`): copy this file to `.env` and fill in the two ARNs
#   from a prior `agentcore deploy` so local routing can reach the deployed
#   sub-agents.
#     cp .env.example .env
# DEPLOYED (`agentcore deploy`): set these the same way, but as `envVars` on the
#   Orchestrator runtime in agentcore/agentcore.json — see the README deploy step
#   "write the Reasoning/Layout ARNs into the Orchestrator's env, then deploy
#   again." The Orchestrator can't know its sub-agents' ARNs until they're first
#   deployed, so this is always a second pass.
#
# `.env` is gitignored; this `.env.example` is the committed template.

# ── REASONING_AGENT_RUNTIME_ARN ──────────────────────────────────────────────
# ARN of the deployed Reasoning runtime. The Orchestrator delegates a new prompt
# to it via bedrock-agentcore:InvokeAgentRuntime. (A confirmed mutation is pure
# deterministic canvas_core work — the Orchestrator echoes the operation back and
# the Django backend applies + persists it, so no Layout runtime is involved.)
# Get it after the first `agentcore deploy`:
#     agentcore status            # lists the runtime ARN
# If left blank the Orchestrator returns a graceful "ARN not configured" answer.
# Format: arn:aws:bedrock-agentcore:<region>:<account-id>:runtime/<RuntimeId>
REASONING_AGENT_RUNTIME_ARN=

# ── AWS_REGION ───────────────────────────────────────────────────────────────
# Region where the runtimes live; used to build the bedrock-agentcore client.
# Defaults to ap-south-1 in code if unset. AWS credentials come from your usual
# AWS CLI config / the runtime execution role — never from this file.
AWS_REGION=ap-south-1
