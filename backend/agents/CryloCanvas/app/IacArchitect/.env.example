# IacArchitect agent — environment template
#
# LOCAL DEV (`agentcore dev`): copy this file to `.env` and fill in values.
#     cp .env.example .env
# DEPLOYED (`agentcore deploy`): do NOT set these here. The gateway URL is
#   auto-injected into the runtime when the gateway is bound to it; AWS region /
#   credentials come from the runtime's execution role.
#
# `.env` is gitignored; this `.env.example` is the committed template.

# ── AGENTCORE_GATEWAY_CRYLOIACGW_URL ─────────────────────────────────────────
# MCP Gateway endpoint. IacArchitect connects to its OWN gateway (CryloIacGw),
# which exposes the full CloudFormation authoring toolset (cfn-lint validate,
# cfn-guard compliance, CFN doc search, pre-deploy instructions) plus docs/
# pricing. The variable name is fixed by the gateway name (CryloIacGw):
# AGENTCORE_GATEWAY_<GATEWAYNAME_UPPERCASE>_URL.
#
#   - Leave UNSET to run with NO MCP tools (the model authors a template but
#     cannot self-validate; the Django backend still lints it).
#   - To exercise the real tools locally, paste the URL printed after the gateway
#     is deployed. Format:
#     https://<gateway-id>.gateway.bedrock-agentcore.<region>.amazonaws.com/mcp
AGENTCORE_GATEWAY_CRYLOIACGW_URL=

# ── AWS_REGION ───────────────────────────────────────────────────────────────
# Region for the Bedrock model call. Only needed for local dev — the deployed
# runtime uses its own region. AWS credentials come from your AWS CLI config.
AWS_REGION=ap-south-1
