DEBUG=True
SECRET_KEY=django-insecure-replace-this-before-production
DATABASE_URL=postgres://clyro:clyro@localhost:5432/clyro_db
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AWS Cognito — values from: cd infrastructure/foundation && terraform output
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=

# GitHub App — create at github.com/settings/apps; place github-app.pem in backend/
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_PRIVATE_KEY_PATH=github-app.pem

# AWS — Bedrock + general AWS access (a named profile in ~/.aws, or 'default')
AWS_PROFILE=default
AWS_REGION=ap-south-1

# AgentCore runtimes — REQUIRED for Step 1 scan and Step 3 canvas
#   REPORECON  → Step 1 repo scan
#   REASONING  → Step 3 canvas prompts
#   IAC        → Step 4 CloudFormation generate/refine (validate works without it)
REPORECON_RUNTIME_ARN=
REASONING_RUNTIME_ARN=
IAC_RUNTIME_ARN=
# AgentCore Memory for Step 3 canvas chat persistence (empty = persistence off)
AGENTCORE_MEMORY_ID=
