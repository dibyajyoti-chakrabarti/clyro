DEBUG=True
SECRET_KEY=django-insecure-replace-this-before-production
DATABASE_URL=postgres://clyro:clyro@localhost:5432/clyro_db
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# AWS Cognito — values from: cd infrastructure/foundation && terraform output
COGNITO_REGION=ap-south-1
COGNITO_USER_POOL_ID=

# GitHub App — create at github.com/settings/apps; place github-app.pem in backend/
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_PRIVATE_KEY_PATH=github-app.pem

# AWS — Bedrock + general AWS access (a named profile in ~/.aws, or 'default')
# AWS_PROFILE is only used in local development (DEBUG=True); in production the
# compute's attached IAM role provides credentials automatically.
AWS_PROFILE=default
AWS_REGION=ap-south-1
# REQUIRED — Clyro's own AWS account ID; embedded in the bootstrap CFN template
# so the cross-account role trusts only this account. Never use a hardcoded default.
CLYRO_AWS_ACCOUNT_ID=

# AgentCore runtimes — REQUIRED for Step 3 canvas
#   REASONING  → Step 3 canvas prompts
#   IAC        → Step 4 CloudFormation generate/refine (validate works without it)
# Step 1 needs no runtime: it ingests the CLYRO.md an offline agent commits.
REASONING_RUNTIME_ARN=
IAC_RUNTIME_ARN=
# Warm the IaC runtime on canvas finalize so Step-4 Generate skips cold-start
# (~17s cold vs ~3s warm). Enable ONLY after CryloIac is redeployed with the
# mode='warmup' short-circuit, else a warm-up ping would trigger a real generate.
IAC_WARMUP_ENABLED=true
# AgentCore Memory for Step 3 canvas chat persistence (empty = persistence off)
AGENTCORE_MEMORY_ID=

#Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
