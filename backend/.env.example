DEBUG=True
SECRET_KEY=django-insecure-replace-this-before-production
DATABASE_URL=postgres://clyro:clyro@localhost:5432/clyro_db
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AWS Cognito — get values from Slack
COGNITO_REGION=
COGNITO_USER_POOL_ID=

# GitHub App — get values from Slack
# Place your github-app.pem in the backend/ directory (or point GITHUB_APP_PRIVATE_KEY_PATH at it)
GITHUB_APP_ID=
GITHUB_APP_NAME=
GITHUB_APP_PRIVATE_KEY_PATH=github-app.pem

# AWS — Bedrock + general AWS access (a named profile in ~/.aws, or leave default)
AWS_PROFILE=default
AWS_REGION=ap-south-1

# AgentCore runtimes — deployed agent ARNs. REQUIRED (no local fallback): the
# Step 1 scan and Step 3 canvas prompts error out if their ARN is unset.
#   REPORECON  → Step 1 repo scan
#   REASONING  → Step 3 canvas prompts
REPORECON_RUNTIME_ARN=
REASONING_RUNTIME_ARN=
# AgentCore Memory for Step 3 canvas chat persistence (empty = persistence off)
AGENTCORE_MEMORY_ID=
