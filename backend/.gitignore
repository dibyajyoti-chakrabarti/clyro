# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
#
# Anchored with a leading slash so each pattern means "the setuptools artifact
# directory beside this file" and not "any directory with this name, at any
# depth". Unanchored, `lib/` silently swallowed
# agents/*/agentcore/cdk/lib/cdk-stack.ts, which is how the AgentCore CDK
# scaffold came to be missing from the repository and the agent deploy came to
# have no CI path. Nothing here is a name that only setuptools ever uses, so
# every one of them could have done the same.
.Python
/build/
/dist/
/downloads/
/.eggs/
/lib/
/lib64/
/parts/
/sdist/
/var/
/wheels/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.hypothesis/

# Environments
.env
.env.*
!.env.example
*.env
.envrc
# but DO track committed templates (no secrets — placeholders only)
!.env.example
!*.env.example
.venv/
venv/
ENV/
env/

# Django stuff
*.log
local_settings.py
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Type checker and notebooks
.dmypy.json
dmypy.json
.ipynb_checkpoints/
.python-version
coverage.xml
