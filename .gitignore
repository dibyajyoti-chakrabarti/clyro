# Environment files
backend/.env.local
backend/.env.production
backend/.env
frontend/.env.local

# GitHub App private key
backend/*.pem

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
backend/.venv/
*.egg-info/
dist/
build/

# Django
backend/db.sqlite3
backend/staticfiles/

# Node
frontend/node_modules/
frontend/dist/

# Misc
.DS_Store
*.log

# Terraform — provider cache and state (state lives in S3 remote backend)
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
# Do NOT ignore .terraform.lock.hcl — it pins provider versions (like package-lock.json)
# Do NOT ignore *.tfvars — they contain non-secret config (secrets passed via -var flags)
