# Environment files
backend/.env.local
backend/.env.production
backend/.env
frontend/.env.local

# GitHub App private key
backend/*.pem

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
backend/.venv/
*.egg-info/
dist/
build/

# Django
backend/db.sqlite3
backend/staticfiles/

# Node
frontend/node_modules/
frontend/dist/

# Misc
.DS_Store
*.log
.playwright-mcp/

# Celery beat's local schedule state (runtime artifact, not source)
backend/celerybeat-schedule*

# Terraform — provider cache and state (state lives in S3 remote backend)
**/.terraform/
*.tfstate
*.tfstate.backup
*.tfstate.lock.info
# Renamed-aside state from a previous account, and its provider cache. Kept on
# disk so the old account can still be torn down, never committed.
*.tfstate.*
.terraform.*/
# Do NOT ignore .terraform.lock.hcl — it pins provider versions (like package-lock.json)
# Do NOT ignore *.tfvars — they contain non-secret config (secrets passed via -var flags)

# graphify (personal tooling — generated graph + machine-specific hook paths)
graphify-out/
.claude/
tfplan
*.tfplan
