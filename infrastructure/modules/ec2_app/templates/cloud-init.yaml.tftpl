#cloud-config
# First-boot configuration for the Clyro application instance.
#
# Everything here is idempotent and re-runnable, because the same steps are
# what a rebuild relies on. Nothing secret is written into this file: it is
# readable through the instance metadata service by anything running on the
# box, so it carries only pointers, and the application resolves the values
# from SSM at start up.

package_update: true

packages:
  - docker
  - amazon-ssm-agent
  - postgresql16
  - cronie

write_files:
  # 2 GB of RAM is genuinely tight for postgres, redis, gunicorn and two celery
  # processes. Swap does not make it fast, it makes the difference between a
  # slow request and the OOM killer taking out postgres mid-transaction.
  - path: /opt/clyro/setup-swap.sh
    permissions: '0755'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      [ -f /swapfile ] && exit 0
      dd if=/dev/zero of=/swapfile bs=1M count=2048 status=none
      chmod 600 /swapfile
      mkswap /swapfile
      swapon /swapfile
      echo '/swapfile none swap sw 0 0' >> /etc/fstab

  - path: /opt/clyro/.env
    permissions: '0640'
    content: |
      AWS_REGION=${aws_region}
      AWS_DEFAULT_REGION=${aws_region}
      CLYRO_SSM_PREFIX=${ssm_prefix}
      BACKEND_IMAGE=${backend_image}
      API_DOMAIN=${api_domain}
      BACKUPS_BUCKET=${backups_bucket}
      POSTGRES_USER=clyro
      POSTGRES_DB=clyro_db

  - path: /opt/clyro/docker-compose.yml
    permissions: '0644'
    content: |
      # Deliberately the same service set as the repository's
      # docker-compose.yml, minus the two frontends, which are static bundles
      # on S3 and CloudFront. Prod matching local is the whole point of the
      # consolidation: it removes an entire class of "works locally, breaks in
      # Lambda" failures.
      services:
        db:
          image: postgres:16-alpine
          restart: unless-stopped
          environment:
            POSTGRES_USER: $${POSTGRES_USER}
            POSTGRES_DB: $${POSTGRES_DB}
            POSTGRES_PASSWORD: $${POSTGRES_PASSWORD}
          volumes:
            - db_data:/var/lib/postgresql/data
          healthcheck:
            test: ["CMD-SHELL", "pg_isready -U $${POSTGRES_USER} -d $${POSTGRES_DB}"]
            interval: 5s
            timeout: 5s
            retries: 10

        redis:
          image: redis:7-alpine
          restart: unless-stopped
          # Replaces SQS as the Celery broker. Losing queued jobs on a reboot
          # is acceptable here; every task is retriable and none is a payment.
          command: ["redis-server", "--save", "", "--appendonly", "no"]
          healthcheck:
            test: ["CMD", "redis-cli", "ping"]
            interval: 5s
            timeout: 5s
            retries: 10

        backend:
          image: $${BACKEND_IMAGE}
          restart: unless-stopped
          # Bound to loopback, not 0.0.0.0. nginx reaches it over the host
          # network; nothing off-box can, even if the security group is ever
          # widened by mistake.
          ports:
            - "127.0.0.1:8000:8000"
          # uvicorn, not gunicorn: requirements.txt pins uvicorn and has no
          # gunicorn at all, and config/asgi.py is a stock Django ASGI app.
          command: uvicorn config.asgi:application --host 0.0.0.0 --port 8000 --workers 3
          environment:
            DATABASE_URL: postgres://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@db:5432/$${POSTGRES_DB}
            CELERY_BROKER_URL: redis://redis:6379/1
            CELERY_RESULT_BACKEND: redis://redis:6379/1
            CLYRO_SSM_PREFIX: $${CLYRO_SSM_PREFIX}
            AWS_REGION: $${AWS_REGION}
            AWS_DEFAULT_REGION: $${AWS_REGION}
          depends_on:
            db: { condition: service_healthy }
            redis: { condition: service_healthy }

        celery_worker:
          image: $${BACKEND_IMAGE}
          restart: unless-stopped
          command: celery -A config worker --loglevel=info --concurrency=2
          environment:
            DATABASE_URL: postgres://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@db:5432/$${POSTGRES_DB}
            CELERY_BROKER_URL: redis://redis:6379/1
            CELERY_RESULT_BACKEND: redis://redis:6379/1
            CLYRO_SSM_PREFIX: $${CLYRO_SSM_PREFIX}
            AWS_REGION: $${AWS_REGION}
            AWS_DEFAULT_REGION: $${AWS_REGION}
          depends_on:
            db: { condition: service_healthy }
            redis: { condition: service_healthy }

        celery_beat:
          image: $${BACKEND_IMAGE}
          restart: unless-stopped
          command: celery -A config beat --loglevel=info
          environment:
            DATABASE_URL: postgres://$${POSTGRES_USER}:$${POSTGRES_PASSWORD}@db:5432/$${POSTGRES_DB}
            CELERY_BROKER_URL: redis://redis:6379/1
            CELERY_RESULT_BACKEND: redis://redis:6379/1
            CLYRO_SSM_PREFIX: $${CLYRO_SSM_PREFIX}
            AWS_REGION: $${AWS_REGION}
            AWS_DEFAULT_REGION: $${AWS_REGION}
          depends_on:
            db: { condition: service_healthy }
            redis: { condition: service_healthy }

        nginx:
          image: nginx:1.27-alpine
          restart: unless-stopped
          network_mode: host
          volumes:
            - /opt/clyro/nginx.conf:/etc/nginx/conf.d/default.conf:ro
            - /etc/letsencrypt:/etc/letsencrypt:ro
            - /var/www/certbot:/var/www/certbot:ro

      volumes:
        db_data:

  # Served over plain HTTP until certbot has a certificate, then rewritten by
  # the certbot deploy hook below. Starting with the TLS server block present
  # would stop nginx from starting at all, which would also stop the ACME
  # challenge that produces the certificate. Chicken and egg, resolved by
  # beginning without TLS.
  - path: /opt/clyro/nginx.conf
    permissions: '0644'
    content: |
      server {
        listen 80;
        server_name ${api_domain};

        location /.well-known/acme-challenge/ {
          root /var/www/certbot;
        }

        location / {
          proxy_pass http://127.0.0.1:8000;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_read_timeout 120s;
        }
      }

  - path: /opt/clyro/nginx-tls.conf
    permissions: '0644'
    content: |
      server {
        listen 80;
        server_name ${api_domain};

        location /.well-known/acme-challenge/ {
          root /var/www/certbot;
        }

        location / {
          return 301 https://$host$request_uri;
        }
      }

      server {
        listen 443 ssl;
        http2 on;
        server_name ${api_domain};

        ssl_certificate     /etc/letsencrypt/live/${api_domain}/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/${api_domain}/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_prefer_server_ciphers off;

        # HSTS is set here rather than in Django because nginx is the only
        # thing that sees the real scheme.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

        client_max_body_size 25m;

        location / {
          proxy_pass http://127.0.0.1:8000;
          proxy_set_header Host $host;
          proxy_set_header X-Real-IP $remote_addr;
          proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
          proxy_set_header X-Forwarded-Proto $scheme;
          proxy_read_timeout 120s;
        }
      }

  # Resolves the database password from SSM and starts the stack. Kept as a
  # script rather than inlined into runcmd so the deploy workflow can call the
  # same code path through SSM send-command.
  - path: /opt/clyro/up.sh
    permissions: '0750'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      cd /opt/clyro
      set -a; . /opt/clyro/.env; set +a

      # Never written to disk, never passed on a command line where it would
      # show up in ps. Compose reads it from this process's environment.
      POSTGRES_PASSWORD="$(aws ssm get-parameter \
        --name "$CLYRO_SSM_PREFIX/db/password" --with-decryption \
        --region "$AWS_REGION" --query Parameter.Value --output text)"
      export POSTGRES_PASSWORD

      aws ecr get-login-password --region "$AWS_REGION" \
        | docker login --username AWS --password-stdin "$${BACKEND_IMAGE%%/*}"

      # Brought up in two phases on purpose. A single "compose up" aborts the
      # entire stack when any one image cannot be pulled, so on a first boot,
      # before any backend image has been pushed, postgres, redis and nginx all
      # got rolled back too. That also took out the ACME challenge nginx has to
      # serve, so the box came up with no database, no proxy and no certificate
      # because of one missing tag.
      #
      # The infrastructure services own no application code and always start.
      docker compose up -d --remove-orphans db redis nginx

      # The application services are allowed to fail while the image is absent.
      if docker compose pull backend 2>/dev/null; then
        docker compose up -d backend celery_worker celery_beat
      else
        echo "backend image not in ECR yet; infrastructure services are up, app deferred" >&2
      fi

      docker image prune -f

  - path: /opt/clyro/backup.sh
    permissions: '0750'
    content: |
      #!/usr/bin/env bash
      # Nightly logical backup. Complements the EBS snapshot: this one is
      # transactionally consistent and restores onto any Postgres, where the
      # snapshot restores the whole machine.
      set -euo pipefail
      set -a; . /opt/clyro/.env; set +a

      POSTGRES_PASSWORD="$(aws ssm get-parameter \
        --name "$CLYRO_SSM_PREFIX/db/password" --with-decryption \
        --region "$AWS_REGION" --query Parameter.Value --output text)"

      stamp="$(date -u +%Y%m%dT%H%M%SZ)"
      file="/tmp/clyro-$${stamp}.sql.gz"

      docker compose -f /opt/clyro/docker-compose.yml exec -T \
        -e PGPASSWORD="$POSTGRES_PASSWORD" db \
        pg_dump -U "$POSTGRES_USER" -d "$POSTGRES_DB" | gzip > "$file"

      # Fail loudly on an empty dump rather than uploading a zero-byte file and
      # reporting success. An untested backup is the failure mode worth
      # designing against.
      if [ ! -s "$file" ]; then
        echo "pg_dump produced an empty file; not uploading" >&2
        rm -f "$file"
        exit 1
      fi

      aws s3 cp "$file" "s3://$BACKUPS_BUCKET/postgres/$(basename "$file")" \
        --region "$AWS_REGION"
      rm -f "$file"

  - path: /etc/cron.d/clyro-backup
    permissions: '0644'
    content: |
      # 20:00 UTC, 01:30 IST: after the EBS snapshot, so a bad night leaves
      # both artefacts from the same quiet window.
      0 20 * * * root /opt/clyro/backup.sh >> /var/log/clyro-backup.log 2>&1

  # Certbot rewrites nginx.conf to the TLS version and reloads. Run as a deploy
  # hook so it fires on renewal too, not only on first issue.
  - path: /opt/clyro/enable-tls.sh
    permissions: '0750'
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      set -a; . /opt/clyro/.env; set +a
      cp /opt/clyro/nginx-tls.conf /opt/clyro/nginx.conf
      docker compose -f /opt/clyro/docker-compose.yml exec -T nginx nginx -s reload \
        || docker compose -f /opt/clyro/docker-compose.yml restart nginx

runcmd:
  - /opt/clyro/setup-swap.sh
  - systemctl enable --now docker
  - systemctl enable --now amazon-ssm-agent
  - systemctl enable --now crond
  - mkdir -p /var/www/certbot /etc/letsencrypt
  # The compose plugin is not in the AL2023 repositories.
  - mkdir -p /usr/local/lib/docker/cli-plugins
  - curl -fsSL -o /usr/local/lib/docker/cli-plugins/docker-compose https://github.com/docker/compose/releases/download/v2.29.7/docker-compose-linux-aarch64
  - chmod +x /usr/local/lib/docker/cli-plugins/docker-compose
  - dnf install -y python3-pip
  - pip3 install --quiet certbot
  # Brings up postgres, redis and nginx immediately. The backend containers
  # stay down until an image has been pushed, which is expected on a first
  # build and is what the deploy workflow fixes.
  - /opt/clyro/up.sh || true
  # webroot rather than standalone: nginx is already holding port 80, and
  # taking it down to answer the challenge would mean downtime on every renewal.
  - certbot certonly --webroot -w /var/www/certbot -d ${api_domain} --email ${letsencrypt_email} --agree-tos --non-interactive --deploy-hook /opt/clyro/enable-tls.sh || true
